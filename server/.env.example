# Server env
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_cost_intel?schema=public

# JWT secrets (use strong random strings in production)
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-min-16-chars
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret-min-16-chars

# Token expirations (jsonwebtoken format: 15m, 7d, etc.)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
